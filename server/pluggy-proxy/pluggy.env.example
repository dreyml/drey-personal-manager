# Copie para /etc/nxuslife/pluggy.env (dono root, chmod 600). Nunca suba este arquivo preenchido.
PLUGGY_CLIENT_ID=coloque-o-client-id-aqui
PLUGGY_CLIENT_SECRET=coloque-o-client-secret-aqui
# Ids das conexões (items) separados por vírgula: Nubank, Sicoob, Mercado Pago
PLUGGY_ITEM_IDS=item-id-1,item-id-2,item-id-3
# Gere com: openssl rand -hex 32  (o mesmo valor vai no app)
NXUS_API_TOKEN=gere-com-openssl-rand-hex-32
